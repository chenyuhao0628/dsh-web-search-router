{
  "name": "dsh-web-search-router",
  "version": "0.1.0",
  "description": "Free multi-provider web search router for DeepSeek Harness (DSH).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test tests/*.test.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenyuhao0628/dsh-web-search-router.git"
  },
  "homepage": "https://github.com/chenyuhao0628/dsh-web-search-router#readme",
  "bugs": {
    "url": "https://github.com/chenyuhao0628/dsh-web-search-router/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "web-search",
    "search-router"
  ],
  "license": "MIT",
  "author": "chenyuhao0628"
}
